#!/bin/bash
#PBS -q {{GPU_QUEUE}}
#PBS -P {{NCI_PROJECT}}
# NOTE: ngpus=4 matches production TP requirement. Design says "1 GPU" but
# configured models (gemma-4-31B-it, gpt-oss-120b) require TP=4 to load.
#PBS -l ngpus=4
#PBS -l ncpus=48
#PBS -l mem=380GB
#PBS -l walltime=00:30:00
#PBS -l jobfs=50GB
#PBS -l storage=scratch/{{NCI_PROJECT}}
#PBS -N llm-discovery-ping
#PBS -o llm-discovery-ping.out
#PBS -e llm-discovery-ping.err

module load cuda/12.9.0
module load singularity

REMOTE_BASE="/scratch/{{NCI_PROJECT}}/llm-discovery"
DATA_DIR="${REMOTE_BASE}/data"
HF_CACHE="/scratch/{{NCI_PROJECT}}/hf_cache"
CONTAINER_PATH="{{CONTAINER_PATH}}"

# Redirect caches to current job's jobfs to avoid stale paths from
# previous jobs (PermissionError on /jobfs/<old-job-id>/).
# VLLM_CACHE_ROOT: vLLM's compile cache (default ~/.cache/vllm/)
# TORCHINDUCTOR_CACHE_DIR: torch inductor cache (default /tmp/torchinductor_*)
export VLLM_CACHE_ROOT="${PBS_JOBFS}/vllm_cache"
export TORCHINDUCTOR_CACHE_DIR="${PBS_JOBFS}/torchinductor"

# Source GPU config for host-side echo
source "${DATA_DIR}/hpc_env.sh"

echo "=== PING TEST ==="
echo "Model:             ${VLLM_MODEL}"
echo "Container:         ${CONTAINER_PATH}"
echo "Reasoning parser:  ${VLLM_REASONING_PARSER:-none}"
echo "Language-model-only: ${VLLM_LANGUAGE_MODEL_ONLY:-0}"
echo "Max model len:     ${VLLM_MAX_MODEL_LEN:-default}"

# Start vLLM inside container using lib_vllm_cmd.sh so the ping measures
# production flags (reasoning-parser, language-model-only, etc.) — NOT a
# stripped-down command that would over-report KV-cache headroom.
# The "Maximum concurrency for N tokens per request: X.XXx" line in vLLM
# startup logs is the authoritative sizing measurement.
singularity exec --nv \
    --bind "${DATA_DIR}:/data" \
    --bind "${HF_CACHE}:/model_cache" \
    --env HF_HOME=/model_cache \
    --env VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT}" \
    --env TORCHINDUCTOR_CACHE_DIR="${TORCHINDUCTOR_CACHE_DIR}" \
    "${CONTAINER_PATH}" \
    bash -c '
        source /data/hpc_env.sh
        source /opt/llm-discovery/container/lib_vllm_cmd.sh
        mapfile -t CMD < <(build_vllm_cmd)
        echo "Command: ${CMD[*]}"
        exec "${CMD[@]}"
    ' &

VLLM_PID=$!

# Poll /health until ready (timeout 20 minutes)
echo "Waiting for vLLM to start..."
for i in $(seq 1 240); do
    if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
        echo "vLLM healthy after ~$((i * 5))s"
        break
    fi
    if ! kill -0 $VLLM_PID 2>/dev/null; then
        echo "FAIL: vLLM process died"
        exit 1
    fi
    sleep 5
done

# Verify health
if ! curl -sf http://localhost:8000/health > /dev/null 2>&1; then
    echo "FAIL: vLLM did not become healthy within 20 minutes"
    kill $VLLM_PID 2>/dev/null
    exit 1
fi

# Send test completion
echo "Sending test completion..."
RESPONSE=$(curl -sf http://localhost:8000/v1/completions \
    -H "Content-Type: application/json" \
    -d "{\"model\": \"${VLLM_MODEL}\", \"prompt\": \"PING?\", \"max_tokens\": 5, \"temperature\": 0}")

echo "Response: ${RESPONSE}"

if [ -z "${RESPONSE}" ]; then
    echo "FAIL: Empty response from /v1/completions"
    kill $VLLM_PID 2>/dev/null
    exit 1
fi

echo "PASS: vLLM responded to PING"

# Clean shutdown
kill $VLLM_PID 2>/dev/null
wait $VLLM_PID 2>/dev/null
echo "=== PING TEST COMPLETE ==="
